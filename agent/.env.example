# LLM
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...                  # optional fallback

# TradingAgents upstream env overrides
TRADINGAGENTS_LLM_PROVIDER=anthropic
TRADINGAGENTS_DEEP_THINK_LLM=claude-opus-4-7
TRADINGAGENTS_QUICK_THINK_LLM=claude-sonnet-4-6
TRADINGAGENTS_OUTPUT_LANGUAGE=English
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1

# US data
POLYGON_API_KEY=...
FINNHUB_API_KEY=...
SEC_EDGAR_USER_AGENT="Trading Research canberk@example.com"

# Sentiment
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USER_AGENT="trading-research/0.1"
X_BEARER_TOKEN=...

# Commentator feed (docs/adr/009-commentator-feed.md). Off unless exactly 1.
# With it on, daily_run.sh fetches once before the tickers and the sentiment
# analyst reads a labelled opinion block. A missing key skips that source; a
# placeholder "..." counts as missing. X also needs a numeric user id, pinned
# once with `python -m scripts.commentator_fetch --resolve-x-id BoraOzkentNSDQ`;
# a handle is refused. With no source usable at all, the flag changes no
# prompt: the pipeline logs that once and leaves the block out.
#COMMENTATOR_FEED=1
# Leave YOUTUBE_API_KEY unset: with it, the fetch creates derived data from
# YouTube API Data, which the Developer Policies (III.E.4) prohibit. That is
# an unresolved legal risk; see ADR-009 "Enabling YouTube — preconditions".
# The code refuses the key unless COMMENTATOR_YOUTUBE_CLEARED=1, the record
# that those preconditions are met in writing. Do not set it before.
#YOUTUBE_API_KEY=
#COMMENTATOR_X_USER_ID=
# Wall-clock bound on one extraction call, SDK retries included (default 60,
# max 600). A timed-out item is stored unextracted and retried next run.
#COMMENTATOR_EXTRACT_TIMEOUT_S=60

# Macro
FRED_API_KEY=...

# Brokers
ALPACA_API_KEY=...
ALPACA_API_SECRET=...
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# AWS
AWS_PROFILE=rootingo
AWS_REGION=eu-west-1

# Storage
S3_DATA_BUCKET=ai-trader-data-dev
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trader

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Alerting off the phone. A blank one is served on /readyz and the off-box
# watchdog opens an incident about it (preflight records it, without failing).
# healthchecks.io ping URL: daily_run.sh pings it on success, <url>/fail on
# failure, and a run that never happens pings nothing (that silence pages).
# On the box these belong in /opt/ai-trader/secrets.env; set here, they only
# fill in what the environment lacks (daily_run.sh never lets a blank one here
# switch a configured channel off). Commented out, so a copy of this file
# changes nothing.
#HEALTHCHECK_URL=
# Box alerts are also filed as GitHub issues, by the box-alert workflow the box
# dispatches: fine-grained PAT, Actions read/write on OPS_ALERT_GITHUB_REPO only.
# The default repo is public.
#OPS_ALERT_GITHUB_TOKEN=
#OPS_ALERT_GITHUB_REPO=fusapp/trading

# Risk caps are not env settings. They are scripts/trade.py flags
# (--max-position-pct 0.10, --max-sector-pct 0.30, --max-cash-utilization 1.0),
# and scripts/daily_run.sh passes none of them, so those defaults are the live
# values. A cap name set here or in secrets.env does nothing.
#
# Not configurable, so deliberately absent (MAX_DAILY_DRAWDOWN and
# KILL_SWITCH_POLL_INTERVAL_SECONDS used to be listed here, and nothing read
# them): the daily-drawdown halt is 3% of the session's opening equity,
# CircuitBreaker(max_daily_dd=0.03) in tradingagents_us/risk/circuit_breaker.py;
# the kill-switch file is re-read at most every 5s, CachedKillSwitchReader in
# tradingagents_us/risk/kill_switch.py. Setting either name here does nothing.
