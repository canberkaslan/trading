# LLM
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...                  # optional fallback

# TradingAgents upstream env overrides
TRADINGAGENTS_LLM_PROVIDER=anthropic
TRADINGAGENTS_DEEP_THINK_LLM=claude-opus-4-7
TRADINGAGENTS_QUICK_THINK_LLM=claude-sonnet-4-6
TRADINGAGENTS_OUTPUT_LANGUAGE=English
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1

# US data
POLYGON_API_KEY=...
FINNHUB_API_KEY=...
SEC_EDGAR_USER_AGENT="Trading Research canberk@example.com"

# Sentiment
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
REDDIT_USER_AGENT="trading-research/0.1"
X_BEARER_TOKEN=...

# Macro
FRED_API_KEY=...

# Brokers
ALPACA_API_KEY=...
ALPACA_API_SECRET=...
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# AWS
AWS_PROFILE=rootingo
AWS_REGION=eu-west-1

# Storage
S3_DATA_BUCKET=ai-trader-data-dev
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trader

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Alerting off the phone. Preflight reports each blank one as a failure.
# healthchecks.io ping URL: daily_run.sh pings it on success, <url>/fail on
# failure, and a run that never happens pings nothing (that silence pages).
HEALTHCHECK_URL=
# Box alerts are also filed as GitHub issues: fine-grained PAT, Issues
# read/write on OPS_ALERT_GITHUB_REPO only. The default repo is public.
OPS_ALERT_GITHUB_TOKEN=
OPS_ALERT_GITHUB_REPO=canberkaslan/trading

# Risk caps. scripts/daily_run.sh forwards each one to scripts/trade.py as a
# flag ONLY when it is set and non-blank; commented out, the run uses trade.py's
# own defaults (--max-position-pct 0.10, --max-sector-pct 0.30,
# --max-cash-utilization 1.0), which are the real values. Fractions, not
# percents: 0.10 is 10%, and trade.py refuses anything outside (0, 1].
# Uncomment only to change a cap; a copied default pins today's value and hides
# a later change to it in trade.py.
#MAX_POSITION_PCT=0.10
#MAX_SECTOR_PCT=0.30
#MAX_CASH_UTILIZATION=1.0
#
# Not configurable, so deliberately absent (MAX_DAILY_DRAWDOWN and
# KILL_SWITCH_POLL_INTERVAL_SECONDS used to be listed here, and nothing read
# them): the daily-drawdown halt is 3% of the session's opening equity,
# CircuitBreaker(max_daily_dd=0.03) in tradingagents_us/risk/circuit_breaker.py;
# the kill-switch file is re-read at most every 5s, CachedKillSwitchReader in
# tradingagents_us/risk/kill_switch.py. Setting either name here does nothing.
